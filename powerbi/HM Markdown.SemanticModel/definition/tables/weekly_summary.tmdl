table weekly_summary
	lineageTag: 26b96240-3131-4f78-b2d4-86f5286fe6bd

	measure '% Units Marked Down' =
			DIVIDE (
			    CALCULATE ( SUM ( weekly_summary[units] ), weekly_summary[price_status] = "Marked down" ),
			    CALCULATE ( SUM ( weekly_summary[units] ), weekly_summary[price_status] <> "Launched before data" )
			)
		formatString: 0%
		displayFolder: Measures
		lineageTag: f95c43c0-8846-40c7-b5df-6c4b9c40e43f

	column week_start
		dataType: dateTime
		formatString: Long Date
		lineageTag: 23e9cbfa-e7fd-4eb7-888b-0b6e92fc9b26
		summarizeBy: none
		sourceColumn: week_start

		variation Variation
			isDefault
			relationship: 23030901-df10-4f63-a678-5f8b7ffd7a4a
			defaultHierarchy: LocalDateTable_d15cd186-c973-469e-af3a-58ea3b57a77a.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column index_group_name
