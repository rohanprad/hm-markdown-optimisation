table markdown_effect
	lineageTag: 84498cf6-912f-4335-90e0-ca006451fb7c

	measure 'Markdowns Analysed' = COUNTROWS ( markdown_effect )
		formatString: #,0
		displayFolder: Measures
		lineageTag: 2ac5152b-31e3-4ae0-bb3c-74bafdaf5b3d

	measure 'Median Unit Lift' = MEDIAN ( markdown_effect[adjusted_unit_lift] )
		formatString: "0.0""x"""
		displayFolder: Measures
		lineageTag: 46404f31-d970-427d-82d3-8e13f424febd

	measure 'Median Revenue Change %' = MEDIAN ( markdown_effect[adjusted_revenue_change] ) - 1
		formatString: "+0%;-0%;0%"
		displayFolder: Measures
		lineageTag: caff8057-29ee-44a2-8be7-324dbf1fb13e

	measure '% Markdowns Grew Revenue' =
			DIVIDE (
			    COUNTROWS ( FILTER ( markdown_effect, markdown_effect[adjusted_revenue_change] >= 1 ) ),
			    [Markdowns Analysed]
			)
		formatString: 0%
		displayFolder: Measures
		lineageTag: 872ad375-40b1-451e-91af-2aa623fae777

