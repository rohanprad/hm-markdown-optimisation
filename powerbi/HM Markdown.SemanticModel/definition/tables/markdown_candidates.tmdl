table markdown_candidates
	lineageTag: c513da68-dcbf-4baf-b8d3-a96151a2570a

	measure 'Live Full-Price Lines' = COUNTROWS ( markdown_candidates )
		formatString: #,0
		displayFolder: Measures
		lineageTag: 5676f532-8874-409c-bcf2-b8bd079e6b38

	measure 'Candidates' = CALCULATE ( COUNTROWS ( markdown_candidates ), markdown_candidates[is_candidate] = TRUE () )
		formatString: #,0
		displayFolder: Measures
		lineageTag: 7ab1510c-a35e-4c3d-85c8-3b1a237b77b1

	measure 'Candidates % of Range' = DIVIDE ( [Candidates], [Live Full-Price Lines] )
		formatString: 0%
		displayFolder: Measures
		lineageTag: ea7c0582-fc58-4a31-bb6e-93f3a5d5f605

	measure 'Candidates % of Revenue' =
			DIVIDE (
			    CALCULATE ( SUM ( markdown_candidates[revenue_now_wk] ), markdown_candidates[is_candidate] = TRUE () ),
			    SUM ( markdown_candidates[revenue_now_wk] )
			)
		formatString: 0%
		displayFolder: Measures
		lineageTag: 928f17cb-00d0-4859-9790-e54fc1207131

	measure 'Expected Extra Units (4 wks)' =
			SUMX (
			    FILTER ( markdown_candidates, markdown_candidates[is_candidate] = TRUE () ),
			    markdown_candidates[ros_now] * 4 * ( markdown_candidates[expected_unit_lift] - 1 )
			)
		formatString: #,0
		displayFolder: Measures
		lineageTag: f5cb483e-7439-48e5-997c-e5106f6a96c1

	measure 'Recommended Depth' = SELECTEDVALUE ( markdown_candidates[recommended_depth], "Varies" )
		formatString: General
		displayFolder: Measures
		lineageTag: 13066755-bb1e-4376-9773-4705ac613e0d

